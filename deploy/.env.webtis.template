APP_NAME=Nexum
APP_ENV=production
APP_KEY=base64:REEMPLAZAR_CON_APP_KEY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://codi.tis.cs.umss.edu.bo

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# PostgreSQL WebTIS — usar localhost en el servidor
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=codi_db
DB_USERNAME=codi
DB_PASSWORD=REEMPLAZAR_CONTRASEÑA_BD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# Correo: log evita errores SMTP en hosting compartido
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nexum@codi.tis.cs.umss.edu.bo"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://codi.tis.cs.umss.edu.bo

# Cloudinary — obligatorio para imágenes y PDFs de proyectos
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

ADMIN_PASSWORD=Admin1234!
